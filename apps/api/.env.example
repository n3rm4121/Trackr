PORT=8000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/trackr

# Generate a real one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

# Access token lifetime: number followed by s/m/h/d (e.g. 15m, 24h)
ACCESS_TOKEN_EXPIRY=15m

# Refresh token lifetime in milliseconds (7 days)
REFRESH_TOKEN_TTL_MS=604800000

# Comma-separated browser origins allowed to send credentialed (cookie) requests
CORS_ORIGINS=http://localhost:5173

# Public base URL of the web app; password reset links are built from it
APP_URL=http://localhost:5173

# How long a password reset link stays usable (1 hour)
PASSWORD_RESET_TOKEN_TTL_MS=3600000

# SMTP delivery. Optional in development, where the reset link is printed to
# the server log instead of being sent. Required when NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Trackr <no-reply@example.com>"

# New accounts start with a sample board, so the board is not empty on arrival.
# Defaults to on outside production; set to false to start every account empty.
# You can also fill an existing account with `pnpm db:seed -- <email>`.
SEED_NEW_USERS=true
